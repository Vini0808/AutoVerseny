<Window x:Class="AutoVerseny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoVerseny"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height ="20" />
            <RowDefinition Height ="70" />
            <RowDefinition Height ="10" />
            <RowDefinition Height = "*" />
        </Grid.RowDefinitions>
        <Button x:Name="start" Content="Start" Width="90" Height ="45" Grid.Row="1" Background="Bisque" Click="start_Click"/>

        <Canvas x:Name="palya" Background="AliceBlue" Grid.Row="3">
            
            <Button x:Name="auto" Content="MAZDA" Width="90" Height="45" Background="DarkGreen" Canvas.Left="20" Canvas.Top="20" Click="auto_Click"/>

            <Button x:Name="auto2" Content="BMW" Width="90" Height="45" Background="LightSkyBlue" Canvas.Left="20" Canvas.Top="120"/>

            <Button x:Name="auto3" Content="AUDI" Width="90" Height="45" Background="IndianRed" Canvas.Left="20" Canvas.Top="220"/>
            
            <TextBox x:Name="col" Width="55" Height="335" Background="Black" Canvas.Right="-5"/>

        </Canvas>
    </Grid>
</Window>
